@implements IDisposable
@inject NavigationManager NavigationManager

<div class="brand">
    <a class="brand-link" href="">
        <span class="brand-logo"><i class="bi bi-people-fill"></i></span>
        <span>
            <span class="brand-name">Кадры</span>
            <span class="brand-sub">Учёт персонала</span>
        </span>
    </a>
</div>

<input type="checkbox" title="Меню" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-section">Меню</div>

        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2" aria-hidden="true"></i> Аналитика
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="departments">
                <i class="bi bi-diagram-3" aria-hidden="true"></i> Отделы
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="positions">
                <i class="bi bi-briefcase" aria-hidden="true"></i> Должности
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="employees">
                <i class="bi bi-people" aria-hidden="true"></i> Сотрудники
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="payroll">
                <i class="bi bi-wallet2" aria-hidden="true"></i> Зарплаты
            </NavLink>
        </div>

        <div class="nav-section">Аккаунт</div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item">
                    <div class="nav-link nav-user">
                        <i class="bi bi-person-circle" aria-hidden="true"></i>
                        <span class="text-truncate">@context.User.Identity?.Name</span>
                    </div>
                </div>
                <div class="nav-item">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Выйти
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Login">
                        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Войти
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Register">
                        <i class="bi bi-person-plus" aria-hidden="true"></i> Регистрация
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
