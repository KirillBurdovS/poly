@implements IDisposable
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark bg-purple-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="">Управление кадрами</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-grid-1x2-fill" aria-hidden="true"></span> Аналитика
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="departments">
                <span class="bi bi-diagram-3-fill" aria-hidden="true"></span> Отделы
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="positions">
                <span class="bi bi-briefcase-fill" aria-hidden="true"></span> Должности
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="employees">
                <span class="bi bi-people-fill" aria-hidden="true"></span> Сотрудники
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="payroll">
                <span class="bi bi-cash-stack" aria-hidden="true"></span> Зарплаты
            </NavLink>
        </div>

        <hr class="text-white opacity-25 mx-3" />

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-circle" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start">
                            <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Выйти
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

<style>
    .bg-purple-dark {
        background-color: #4b2c85 !important;
    }

    .nav-link {
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .bi {
        font-size: 1.2rem;
    }
</style>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
