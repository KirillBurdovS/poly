@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using poly.Models
@using poly.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>Аналитика</PageTitle>

<div class="page-bg">
    <div class="container">
        <div class="welcome-banner mb-4">
            <div class="welcome-text">
                <div class="welcome-date">@DateTime.Now.ToString("dddd, d MMMM yyyy")</div>
                <h1>Управление персоналом</h1>
                <p>Учёт кадров, штатного расписания и фонда оплаты труда в одном месте.</p>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="employees" class="btn btn-light px-4"><i class="bi bi-people me-2"></i>Сотрудники</a>
                    <a href="payroll" class="btn btn-ghost px-4"><i class="bi bi-wallet2 me-2"></i>Зарплаты</a>
                </div>
            </div>
            <i class="bi bi-bar-chart-line welcome-icon"></i>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card br-15 stat-card">
                    <div class="stat-icon"><i class="bi bi-diagram-3"></i></div>
                    <div>
                        <div class="stat-label">Подразделения</div>
                        <div class="stat-value">@departmentsCount</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card br-15 stat-card">
                    <div class="stat-icon orange"><i class="bi bi-people"></i></div>
                    <div>
                        <div class="stat-label">Сотрудников в штате</div>
                        <div class="stat-value">@totalEmployees</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card br-15 stat-card">
                    <div class="stat-icon green"><i class="bi bi-cash-coin"></i></div>
                    <div>
                        <div class="stat-label">Фонд оплаты в месяц</div>
                        <div class="stat-value">@totalSalary.ToString("N0") ₽</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card br-15 overflow-hidden">
            <div class="px-4 py-3 border-bottom">
                <h5 class="card-title mb-0">Распределение по отделам</h5>
            </div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Отдел</th>
                            <th>Сотрудников</th>
                            <th style="width: 32%;">Доля в штате</th>
                            <th class="text-end pe-4">Затраты в месяц</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!deptStats.Any())
                        {
                            <tr><td colspan="4" class="empty-state"><i class="bi bi-pie-chart"></i>Данных пока нет — добавьте отделы и сотрудников</td></tr>
                        }
                        @foreach (var stat in deptStats)
                        {
                            var share = totalEmployees > 0 ? stat.Count * 100 / totalEmployees : 0;
                            <tr>
                                <td class="ps-4 fw-semibold">@stat.DeptName</td>
                                <td class="text-muted">@stat.Count чел.</td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="progress flex-grow-1">
                                            <div class="progress-bar" style="width: @(share)%"></div>
                                        </div>
                                        <span class="small text-muted" style="width: 2.5rem;">@share%</span>
                                    </div>
                                </td>
                                <td class="text-end pe-4 fw-semibold">@stat.SalarySum.ToString("N0") ₽</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .welcome-banner {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        padding: 2.5rem;
        color: #fff;
        background: radial-gradient(circle at 85% 20%, rgba(255, 255, 255, 0.18), transparent 40%),
                    linear-gradient(135deg, #7c5cff 0%, #5135d8 55%, #2b2171 100%);
        box-shadow: 0 16px 40px rgba(81, 53, 216, 0.25);
    }

    .welcome-text {
        position: relative;
        z-index: 1;
        max-width: 620px;
    }

    .welcome-date {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        opacity: 0.7;
        margin-bottom: 0.5rem;
    }

    .welcome-banner h1 {
        font-size: 2.1rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .welcome-banner p {
        opacity: 0.8;
        margin-bottom: 1.5rem;
    }

    .welcome-banner .btn-light {
        background: #fff;
        color: #5135d8;
        border: 0;
    }

    .btn-ghost {
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.4);
    }

        .btn-ghost:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.12);
        }

    .welcome-icon {
        position: absolute;
        right: 2.5rem;
        bottom: -1.5rem;
        font-size: 10rem;
        opacity: 0.12;
    }

    .stat-card {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 1.4rem;
        background: var(--brand-soft);
        color: var(--brand);
    }

        .stat-icon.orange {
            background: #fff1e4;
            color: #f07b16;
        }

        .stat-icon.green {
            background: #e5f7ec;
            color: #1f9d55;
        }

    .stat-label {
        font-size: 0.82rem;
        color: var(--muted);
        font-weight: 500;
    }

    .stat-value {
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .progress {
        height: 8px;
        border-radius: 999px;
        background: #f0eef9;
    }

    .progress-bar {
        border-radius: 999px;
        background: linear-gradient(90deg, #8b70ff, #5135d8);
    }
</style>

@code {
    private int departmentsCount;
    private int totalEmployees;
    private decimal totalSalary;
    private List<DeptStat> deptStats = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // Уволенные не входят в штат и фонд оплаты
        var employees = await db.Employees.Include(e => e.Department)
            .Where(e => e.Status != EmployeeStatus.Terminated)
            .ToListAsync();
        departmentsCount = await db.Departments.CountAsync();
        totalEmployees = employees.Count;
        totalSalary = employees.Sum(e => e.Salary);

        // Группируем данные для таблицы анализа
        deptStats = employees
            .GroupBy(e => e.Department?.Name ?? "Без отдела")
            .Select(g => new DeptStat
            {
                DeptName = g.Key,
                Count = g.Count(),
                SalarySum = g.Sum(e => e.Salary)
            })
            .OrderByDescending(s => s.SalarySum)
            .ToList();
    }

    private class DeptStat
    {
        public string DeptName { get; set; } = "";
        public int Count { get; set; }
        public decimal SalarySum { get; set; }
    }
}
