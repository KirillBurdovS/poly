@page "/payroll"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using poly.Models
@using poly.Data
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Зарплаты</PageTitle>

<div class="page-bg">
    <div class="container">
        <div class="page-header">
            <div>
                <h3 class="page-title"><i class="bi bi-wallet2"></i>Зарплаты</h3>
                <p class="page-subtitle">Учёт отработанных часов и начислений</p>
            </div>
            <div class="summary-chip">
                <span class="text-muted small">Начислено всего</span>
                <span class="fw-bold">@workLogs.Sum(l => l.TotalSalary).ToString("N0") ₽</span>
            </div>
        </div>

        <div class="card br-15 mb-4">
            <div class="card-body p-4">
                <h5 class="card-title mb-3">Внести отработанные часы</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Сотрудник (только работающие)</label>
                        <select class="form-select custom-input" value="@newLog.EmployeeId" @onchange="OnEmployeeSelected">
                            <option value="0">Выберите сотрудника</option>
                            @foreach (var emp in employees.Where(e => e.Status == EmployeeStatus.Active))
                            {
                                <option value="@emp.Id">@emp.FullName (@(emp.Department?.Name ?? "—"))</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Часы</label>
                        <input type="number" min="0.5" max="24" step="0.5" class="form-control custom-input" @bind="newLog.HoursWorked" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Ставка</label>
                        <div class="input-group">
                            <input type="number" min="0" step="0.01" class="form-control custom-input border-end-0" @bind="newLog.HourlyRate" />
                            <span class="input-group-text custom-input-text">₽ / час</span>
                        </div>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-purple w-100 py-2" @onclick="AddWorkLog"><i class="bi bi-check2 me-1"></i>Зафиксировать</button>
                    </div>
                </div>
                @if (error != null)
                {
                    <div class="alert alert-danger mt-3 mb-0">@error</div>
                }
            </div>
        </div>

        <div class="card br-15 overflow-hidden">
            <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Дата</th>
                        <th>Сотрудник</th>
                        <th>Часы</th>
                        <th>Ставка</th>
                        <th class="text-end">Сумма</th>
                        <th class="text-end pe-4"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!workLogs.Any())
                    {
                        <tr><td colspan="6" class="empty-state"><i class="bi bi-clock-history"></i>Записей пока нет</td></tr>
                    }
                    @foreach (var log in workLogs)
                    {
                        <tr>
                            <td class="ps-4 text-muted">@log.Date.ToShortDateString()</td>
                            <td class="fw-semibold">@log.Employee?.FullName</td>
                            <td><span class="badge bg-lavender text-purple">@log.HoursWorked ч</span></td>
                            <td class="text-muted">@log.HourlyRate.ToString("N0") ₽/ч</td>
                            <td class="text-end fw-semibold">@log.TotalSalary.ToString("N0") ₽</td>
                            <td class="text-end pe-4">
                                <button class="btn-icon danger" title="Удалить запись" @onclick="() => DeleteLog(log)"><i class="bi bi-trash3"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Employee> employees = new();
    private List<WorkLog> workLogs = new();
    private WorkLog newLog = new() { HoursWorked = 8 };
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        employees = await db.Employees.Include(e => e.Position).Include(e => e.Department)
            .OrderBy(e => e.FullName).ToListAsync();
        workLogs = await db.WorkLogs.Include(l => l.Employee).OrderByDescending(l => l.Date).ToListAsync();
    }

    private void OnEmployeeSelected(ChangeEventArgs e)
    {
        newLog.EmployeeId = int.TryParse(e.Value?.ToString(), out int id) ? id : 0;
        var emp = employees.FirstOrDefault(x => x.Id == newLog.EmployeeId);
        if (emp?.Position != null) newLog.HourlyRate = emp.Position.BaseSalary;
    }

    private async Task AddWorkLog()
    {
        error = newLog switch
        {
            { EmployeeId: 0 } => "Выберите сотрудника.",
            { HoursWorked: <= 0 or > 24 } => "Часы должны быть от 0 до 24 за одну запись.",
            { HourlyRate: <= 0 } => "Ставка должна быть больше нуля.",
            _ => null
        };
        if (error != null) return;

        newLog.Date = DateTime.Now;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.WorkLogs.Add(newLog);
            await db.SaveChangesAsync();
        }
        newLog = new WorkLog { HoursWorked = 8 };
        await LoadData();
    }

    private async Task DeleteLog(WorkLog log)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Удалить запись {log.Employee?.FullName} от {log.Date:d}?")) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.WorkLogs.Where(l => l.Id == log.Id).ExecuteDeleteAsync();
        await LoadData();
    }
}
