@page "/departments"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using poly.Models
@using poly.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Отделы</PageTitle>

<div class="page-bg">
    <div class="container">
        <div class="page-header">
            <div>
                <h3 class="page-title"><i class="bi bi-diagram-3"></i>Отделы</h3>
                <p class="page-subtitle">Структура предприятия и численность подразделений</p>
            </div>
        </div>

        <div class="card br-15 mb-4">
            <div class="card-body p-4">
                <h5 class="card-title mb-3">Новый отдел</h5>
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Название</label>
                        <input type="text" class="form-control" placeholder="Например: ИТ-отдел" @bind="newDept.Name" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Описание</label>
                        <input type="text" class="form-control" placeholder="Чем занимается отдел" @bind="newDept.Description" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-purple w-100 py-2" @onclick="AddDept"><i class="bi bi-plus-lg me-1"></i>Добавить</button>
                    </div>
                </div>
                @if (error != null)
                {
                    <div class="alert alert-danger mt-3 mb-0">@error</div>
                }
            </div>
        </div>

        @if (!depts.Any())
        {
            <div class="card br-15">
                <div class="empty-state"><i class="bi bi-diagram-3"></i>Отделов пока нет. Создайте первый отдел выше.</div>
            </div>
        }
        <div class="row g-4">
            @foreach (var dept in depts)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card br-15 h-100 card-hover">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="dept-avatar">@dept.Name.Substring(0, 1).ToUpper()</span>
                                    <h5 class="fw-semibold mb-0">@dept.Name</h5>
                                </div>
                                <button class="btn-icon danger" title="Удалить отдел" @onclick="() => DeleteDept(dept)"><i class="bi bi-trash3"></i></button>
                            </div>
                            <p class="text-muted small flex-grow-1 mb-3">@(string.IsNullOrWhiteSpace(dept.Description) ? "Без описания" : dept.Description)</p>
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <span class="badge bg-lavender text-purple"><i class="bi bi-people me-1"></i>@dept.Employees.Count @EmployeesWord(dept.Employees.Count)</span>
                                <a href="employees?dept=@dept.Id" class="small fw-semibold text-decoration-none">Сотрудники <i class="bi bi-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Department> depts = new();
    private Department newDept = new();
    private string? error;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        depts = await db.Departments.Include(d => d.Employees).OrderBy(d => d.Name).ToListAsync();
    }

    private async Task AddDept()
    {
        error = null;
        newDept.Name = newDept.Name.Trim();
        if (string.IsNullOrWhiteSpace(newDept.Name))
        {
            error = "Введите название отдела.";
            return;
        }
        if (depts.Any(d => d.Name.Equals(newDept.Name, StringComparison.OrdinalIgnoreCase)))
        {
            error = "Отдел с таким названием уже есть.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Departments.Add(newDept);
        await db.SaveChangesAsync();
        newDept = new();
        await Load();
    }

    private async Task DeleteDept(Department dept)
    {
        error = null;
        if (dept.Employees.Count > 0)
        {
            error = $"В отделе «{dept.Name}» есть сотрудники. Сначала переведите их в другой отдел.";
            return;
        }
        if (!await JS.InvokeAsync<bool>("confirm", $"Удалить отдел «{dept.Name}»?")) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Departments.Where(d => d.Id == dept.Id).ExecuteDeleteAsync();
        await Load();
    }

    private static string EmployeesWord(int n) => (n % 100, n % 10) switch
    {
        ( >= 11 and <= 14, _) => "сотрудников",
        (_, 1) => "сотрудник",
        (_, >= 2 and <= 4) => "сотрудника",
        _ => "сотрудников"
    };
}
