@page "/positions"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using poly.Models
@using poly.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Должности</PageTitle>

<div class="page-bg">
    <div class="container">
        <div class="page-header">
            <div>
                <h3 class="page-title"><i class="bi bi-briefcase"></i>Должности</h3>
                <p class="page-subtitle">Штатные единицы и почасовые ставки</p>
            </div>
        </div>

        <div class="card br-15 mb-4">
            <div class="card-body p-4">
                <h5 class="card-title mb-3">Новая должность</h5>
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Название должности</label>
                        <input type="text" class="form-control custom-input" placeholder="Например: Старший аналитик" @bind="newPos.Title" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Часовая ставка</label>
                        <div class="input-group">
                            <input type="number" min="0" step="0.01" class="form-control custom-input border-end-0" @bind="newPos.BaseSalary" />
                            <span class="input-group-text custom-input-text">₽ / час</span>
                        </div>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-purple w-100 py-2" @onclick="AddPosition">
                            <i class="bi bi-plus-lg me-2"></i>Добавить
                        </button>
                    </div>
                </div>
                @if (error != null)
                {
                    <div class="alert alert-danger mt-3 mb-0">@error</div>
                }
            </div>
        </div>

        <div class="card br-15 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 90px;">№</th>
                            <th>Наименование</th>
                            <th>Ставка в час</th>
                            <th>Сотрудников</th>
                            <th class="text-end pe-4" style="width: 120px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (positions == null)
                        {
                            <tr><td colspan="5" class="empty-state">Загрузка данных...</td></tr>
                        }
                        else if (!positions.Any())
                        {
                            <tr><td colspan="5" class="empty-state"><i class="bi bi-briefcase"></i>Должностей пока нет. Добавьте первую выше.</td></tr>
                        }
                        else
                        {
                            @foreach (var pos in positions)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">@pos.Id</td>
                                    <td class="fw-semibold">@pos.Title</td>
                                    <td><span class="badge bg-lavender text-purple">@pos.BaseSalary.ToString("N0") ₽</span></td>
                                    <td class="text-muted">@EmployeeCount(pos.Id)</td>
                                    <td class="text-end pe-4">
                                        <button class="btn-icon danger" title="Удалить должность" @onclick="() => DeletePosition(pos)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Position>? positions;
    private Dictionary<int, int> employeeCounts = new();
    private Position newPos = new();
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadPositions();

    private async Task LoadPositions()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        positions = await db.Positions.OrderBy(p => p.Title).ToListAsync();
        employeeCounts = await db.Employees
            .GroupBy(e => e.PositionId)
            .ToDictionaryAsync(g => g.Key, g => g.Count());
    }

    private int EmployeeCount(int positionId) => employeeCounts.GetValueOrDefault(positionId);

    private async Task AddPosition()
    {
        error = null;
        newPos.Title = newPos.Title.Trim();
        if (string.IsNullOrWhiteSpace(newPos.Title))
        {
            error = "Введите название должности.";
            return;
        }
        if (newPos.BaseSalary <= 0)
        {
            error = "Часовая ставка должна быть больше нуля.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Positions.Add(newPos);
        await db.SaveChangesAsync();
        newPos = new Position();
        await LoadPositions();
    }

    private async Task DeletePosition(Position pos)
    {
        error = null;
        if (EmployeeCount(pos.Id) > 0)
        {
            error = $"Должность «{pos.Title}» занята сотрудниками. Сначала переведите их на другую должность.";
            return;
        }
        if (!await JS.InvokeAsync<bool>("confirm", $"Удалить должность «{pos.Title}»?")) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Positions.Where(p => p.Id == pos.Id).ExecuteDeleteAsync();
        await LoadPositions();
    }
}
