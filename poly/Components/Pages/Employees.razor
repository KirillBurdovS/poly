@page "/employees"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using poly.Models
@using poly.Data
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Сотрудники</PageTitle>

<div class="page-bg no-print">
    <div class="container">
        <div class="page-header">
            <div>
                <h3 class="page-title"><i class="bi bi-people"></i>Сотрудники</h3>
                <p class="page-subtitle">Приём, перевод и учёт персонала</p>
            </div>
            <button class="btn btn-outline-purple px-3" @onclick="PrintReport">
                <i class="bi bi-printer me-2"></i>Печать отчёта
            </button>
        </div>

        <div class="card br-15 mb-4">
            <div class="card-body p-4">
                <h5 class="card-title mb-3">Оформить нового сотрудника</h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">ФИО</label>
                        <input type="text" class="form-control custom-input" @bind="newEmployee.FullName" placeholder="Иванов Иван Иванович" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Отдел</label>
                        <select class="form-select custom-input" @bind="newEmployee.DepartmentId">
                            <option value="0">Выберите</option>
                            @foreach (var dept in availableDepartments)
                            {
                                <option value="@dept.Id">@dept.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Должность</label>
                        <select class="form-select custom-input" @bind="newEmployee.PositionId">
                            <option value="0">Выберите</option>
                            @foreach (var pos in availablePositions)
                            {
                                <option value="@pos.Id">@pos.Title</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Статус</label>
                        <select class="form-select custom-input" @bind="newEmployee.Status">
                            @foreach (EmployeeStatus status in Enum.GetValues<EmployeeStatus>())
                            {
                                <option value="@status">@status.ToText()</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Оклад, ₽</label>
                        <input type="number" min="1" class="form-control custom-input" @bind="newEmployee.Salary" />
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button class="btn btn-purple w-100 py-2" title="Нанять" @onclick="AddEmployee"><i class="bi bi-person-plus"></i></button>
                    </div>
                </div>
                @if (error != null)
                {
                    <div class="alert alert-danger mt-3 mb-0">@error</div>
                }
            </div>
        </div>

        <div class="row mb-3 g-2">
            <div class="col-md-8">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" class="form-control" placeholder="Поиск по ФИО..." @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-4">
                <select class="form-select" @bind="filterDeptId">
                    <option value="0">Все отделы</option>
                    @foreach (var dept in availableDepartments)
                    {
                        <option value="@dept.Id">@dept.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="card br-15 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Сотрудник</th>
                            <th>Отдел / Должность</th>
                            <th>Статус</th>
                            <th class="text-end">Оклад</th>
                            <th class="text-end pe-4"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredEmployees.Any())
                        {
                            <tr><td colspan="5" class="empty-state"><i class="bi bi-person-x"></i>Сотрудники не найдены</td></tr>
                        }
                        @foreach (var emp in FilteredEmployees)
                        {
                            <tr>
                                <td class="ps-4">
                                    <a href="employees/@emp.Id" class="d-flex align-items-center gap-3 text-decoration-none employee-link">
                                        <span class="person-avatar">@Initials(emp.FullName)</span>
                                        <span class="fw-semibold">@emp.FullName</span>
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-medium">@(emp.Position?.Title ?? "—")</div>
                                    <small class="text-muted">@(emp.Department?.Name ?? "—")</small>
                                </td>
                                <td><span class="badge @emp.Status.BadgeClass()">@emp.Status.ToText()</span></td>
                                <td class="text-end fw-semibold">@emp.Salary.ToString("N0") ₽</td>
                                <td class="text-end pe-4 text-nowrap">
                                    <button class="btn-icon" title="Редактировать" @onclick="() => EditEmployee(emp)"><i class="bi bi-pencil"></i></button>
                                    <button class="btn-icon danger" title="Удалить" @onclick="() => DeleteEmployee(emp)"><i class="bi bi-trash3"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно редактирования -->
@if (isEditing)
{
    <div class="modal fade show d-block modal-backdrop-soft">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0">
                <div class="modal-header border-0 px-4 pt-4 pb-0">
                    <div class="d-flex align-items-center gap-3">
                        <span class="person-avatar">@Initials(editingEmployee.FullName)</span>
                        <h5 class="modal-title fw-semibold">Редактирование сотрудника</h5>
                    </div>
                    <button type="button" class="btn-close" @onclick="CancelEdit"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label">ФИО</label>
                        <input type="text" class="form-control custom-input" @bind="editingEmployee.FullName" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label">Отдел</label>
                            <select class="form-select custom-input" @bind="editingEmployee.DepartmentId">
                                @foreach (var dept in availableDepartments)
                                {
                                    <option value="@dept.Id">@dept.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Должность</label>
                            <select class="form-select custom-input" @bind="editingEmployee.PositionId">
                                @foreach (var pos in availablePositions)
                                {
                                    <option value="@pos.Id">@pos.Title</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label">Месячный оклад, ₽</label>
                        <input type="number" min="1" class="form-control custom-input" @bind="editingEmployee.Salary" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Статус</label>
                        <select class="form-select custom-input" @bind="editingEmployee.Status">
                            @foreach (EmployeeStatus status in Enum.GetValues<EmployeeStatus>())
                            {
                                <option value="@status">@status.ToText()</option>
                            }
                        </select>
                    </div>
                    </div>
                    @if (editError != null)
                    {
                        <div class="alert alert-danger mt-3 mb-0">@editError</div>
                    }
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button class="btn btn-light px-4" @onclick="CancelEdit">Отмена</button>
                    <button class="btn btn-purple px-4" @onclick="SaveEdit">Сохранить</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Область печати -->
<div class="print-only p-5">
    <h2 class="text-center mb-3">Штатная ведомость персонала</h2>
    <p class="text-center text-muted mb-5">Сформировано: @DateTime.Now.ToString("f")</p>
    <table class="table table-bordered border-dark">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Отдел</th>
                <th>Должность</th>
                <th>Статус</th>
                <th>Оклад</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in FilteredEmployees)
            {
                <tr>
                    <td>@emp.FullName</td>
                    <td>@emp.Department?.Name</td>
                    <td>@emp.Position?.Title</td>
                    <td>@emp.Status.ToText()</td>
                    <td>@emp.Salary.ToString("N0") ₽</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .employee-link {
        color: var(--text);
    }

        .employee-link:hover {
            color: var(--brand);
        }

    .print-only {
        display: none;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        .print-only {
            display: block !important;
        }

        body {
            background: white;
        }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "dept")]
    public int? DeptFromQuery { get; set; }

    private List<Employee> employees = new();
    private List<Position> availablePositions = new();
    private List<Department> availableDepartments = new();

    private Employee newEmployee = NewEmployee();
    private Employee editingEmployee = new();

    private string searchTerm = "";
    private int filterDeptId = 0;
    private bool isEditing = false;
    private string? error;
    private string? editError;

    private IEnumerable<Employee> FilteredEmployees => employees
        .Where(e => string.IsNullOrWhiteSpace(searchTerm) || e.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(e => filterDeptId == 0 || e.DepartmentId == filterDeptId);

    private static string Initials(string? fullName) => string.Concat(
        (fullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));

    private static Employee NewEmployee() => new() { PositionId = 0, DepartmentId = 0, Status = EmployeeStatus.Active };

    protected override async Task OnInitializedAsync()
    {
        filterDeptId = DeptFromQuery ?? 0;
        await LoadData();
    }

    private async Task LoadData()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        employees = await db.Employees.Include(e => e.Position).Include(e => e.Department)
            .OrderBy(e => e.FullName).ToListAsync();
        availablePositions = await db.Positions.OrderBy(p => p.Title).ToListAsync();
        availableDepartments = await db.Departments.OrderBy(d => d.Name).ToListAsync();
    }

    private static string? Validate(Employee emp)
    {
        if (string.IsNullOrWhiteSpace(emp.FullName)) return "Введите ФИО сотрудника.";
        if (emp.DepartmentId == 0) return "Выберите отдел.";
        if (emp.PositionId == 0) return "Выберите должность.";
        if (emp.Salary <= 0) return "Оклад должен быть больше нуля.";
        return null;
    }

    private async Task AddEmployee()
    {
        newEmployee.FullName = newEmployee.FullName.Trim();
        error = Validate(newEmployee);
        if (error != null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Employees.Add(newEmployee);
        await db.SaveChangesAsync();
        newEmployee = NewEmployee();
        await LoadData();
    }

    private void EditEmployee(Employee emp)
    {
        editingEmployee = new Employee
        {
            Id = emp.Id,
            FullName = emp.FullName,
            Salary = emp.Salary,
            Status = emp.Status,
            DepartmentId = emp.DepartmentId,
            PositionId = emp.PositionId
        };
        editError = null;
        isEditing = true;
    }

    private async Task SaveEdit()
    {
        editingEmployee.FullName = editingEmployee.FullName.Trim();
        editError = Validate(editingEmployee);
        if (editError != null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var dbEmp = await db.Employees.FindAsync(editingEmployee.Id);
        if (dbEmp != null)
        {
            dbEmp.FullName = editingEmployee.FullName;
            dbEmp.Salary = editingEmployee.Salary;
            dbEmp.Status = editingEmployee.Status;
            dbEmp.DepartmentId = editingEmployee.DepartmentId;
            dbEmp.PositionId = editingEmployee.PositionId;
            await db.SaveChangesAsync();
        }
        isEditing = false;
        await LoadData();
    }

    private void CancelEdit() => isEditing = false;

    private async Task DeleteEmployee(Employee emp)
    {
        error = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.WorkLogs.AnyAsync(l => l.EmployeeId == emp.Id))
        {
            error = $"У сотрудника «{emp.FullName}» есть история начислений. Вместо удаления установите статус «Уволен».";
            return;
        }
        if (!await JS.InvokeAsync<bool>("confirm", $"Удалить сотрудника «{emp.FullName}»?")) return;

        await db.Employees.Where(e => e.Id == emp.Id).ExecuteDeleteAsync();
        await LoadData();
    }

    private async Task PrintReport() => await JS.InvokeVoidAsync("window.print");
}
