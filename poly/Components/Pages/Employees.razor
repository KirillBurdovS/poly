@page "/employees"
@using poly.Models
@using poly.Data
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject ApplicationDbContext DbContext
@inject IJSRuntime JS

<PageTitle>Учет персонала</PageTitle>

<div class="employees-container py-4 no-print">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="text-purple fw-bold mb-0"><i class="bi bi-people-fill me-2"></i>Управление кадрами</h3>
            <button class="btn btn-outline-purple rounded-pill px-4 shadow-sm" @onclick="PrintReport">
                <i class="bi bi-printer me-2"></i>Печать отчета
            </button>
        </div>

        <!-- Форма найма -->
        <div class="card border-0 shadow-sm mb-4 br-15">
            <div class="card-body p-4">
                <h5 class="card-title text-muted mb-4">Оформить нового сотрудника</h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-secondary">ФИО</label>
                        <input type="text" class="form-control custom-input" @bind="newEmployee.FullName" placeholder="ФИО" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-secondary">Отдел</label>
                        <select class="form-select custom-input" @bind="newEmployee.DepartmentId">
                            <option value="0">-- Отдел --</option>
                            @foreach (var dept in availableDepartments)
                            {
                                <option value="@dept.Id">@dept.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-secondary">Должность</label>
                        <select class="form-select custom-input" @bind="newEmployee.PositionId">
                            <option value="0">-- Должность --</option>
                            @foreach (var pos in availablePositions)
                            {
                                <option value="@pos.Id">@pos.Title</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-secondary">Статус</label>
                        <select class="form-select custom-input" @bind="newEmployee.Status">
                            @foreach (EmployeeStatus status in Enum.GetValues(typeof(EmployeeStatus)))
                            {
                                <option value="@status">@GetStatusText(status)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label small fw-bold text-secondary">Оклад</label>
                        <input type="number" class="form-control custom-input" @bind="newEmployee.Salary" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-purple w-100 rounded-pill py-2 shadow-sm" @onclick="AddEmployee">Нанять</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Фильтры поиска -->
        <div class="row mb-3 g-2">
            <div class="col-md-8">
                <div class="input-group shadow-sm br-8 overflow-hidden">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-0 custom-input"
                           placeholder="Поиск по ФИО..." @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-4">
                <select class="form-select custom-input shadow-sm" @bind="filterDeptId">
                    <option value="0">Все отделы</option>
                    @foreach (var dept in availableDepartments)
                    {
                        <option value="@dept.Id">@dept.Name</option>
                    }
                </select>
            </div>
        </div>

        <!-- Таблица штата -->
        <div class="card border-0 shadow-sm br-15 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-purple-light text-purple">
                        <tr>
                            <th class="ps-4">Статус</th>
                            <th>ФИО</th>
                            <th>Отдел / Должность</th>
                            <th>Оклад</th>
                            <th class="text-center">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in FilteredEmployees)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge rounded-pill @GetStatusClass(emp.Status)">@GetStatusText(emp.Status)</span>
                                </td>
                                <td class="fw-bold">
                                    <a href="employees/@emp.Id" class="text-purple-dark text-decoration-none employee-link">
                                        @emp.FullName <i class="bi bi-box-arrow-in-right opacity-50 ms-1"></i>
                                    </a>
                                </td>
                                <td>
                                    <small class="text-muted d-block">@(emp.Department?.Name ?? "—")</small>
                                    <span class="text-purple small fw-bold">@(emp.Position?.Title ?? "—")</span>
                                </td>
                                <td class="fw-bold">@emp.Salary.ToString("N0") ₽</td>
                                <td class="text-center">
                                    <button class="btn btn-sm text-primary me-2" @onclick="() => EditEmployee(emp)"><i class="bi bi-pencil-square"></i></button>
                                    <button class="btn btn-sm text-danger" @onclick="() => DeleteEmployee(emp.Id)"><i class="bi bi-trash3"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно редактирования -->
@if (isEditing)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content br-15 border-0 shadow-lg">
                <div class="modal-header bg-purple text-white br-top-15">
                    <h5 class="modal-title">Редактирование сотрудника</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelEdit"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">ФИО</label>
                        <input type="text" class="form-control custom-input" @bind="editingEmployee.FullName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Месячный оклад</label>
                        <input type="number" class="form-control custom-input" @bind="editingEmployee.Salary" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-bold text-secondary">Статус</label>
                        <select class="form-select custom-input" @bind="editingEmployee.Status">
                            @foreach (EmployeeStatus status in Enum.GetValues(typeof(EmployeeStatus)))
                            {
                                <option value="@status">@GetStatusText(status)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3">
                    <button class="btn btn-light rounded-pill px-4" @onclick="CancelEdit">Отмена</button>
                    <button class="btn btn-purple rounded-pill px-4 shadow-sm" @onclick="SaveEdit">Сохранить</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Область печати -->
<div class="print-only p-5">
    <h2 class="text-center mb-3">Штатная ведомость персонала</h2>
    <p class="text-center text-muted mb-5">Сформировано: @DateTime.Now.ToString("f")</p>
    <table class="table table-bordered border-dark">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Отдел</th>
                <th>Должность</th>
                <th>Статус</th>
                <th>Оклад</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in FilteredEmployees)
            {
                <tr>
                    <td>@emp.FullName</td>
                    <td>@emp.Department?.Name</td>
                    <td>@emp.Position?.Title</td>
                    <td>@GetStatusText(emp.Status)</td>
                    <td>@emp.Salary.ToString("N0") ₽</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .employees-container {
        min-height: 100vh;
        background-color: #f3f0f7;
    }

    .text-purple {
        color: #6f42c1;
    }

    .text-purple-dark {
        color: #4b2c85;
    }

    .bg-purple-light {
        background-color: #f8f6ff;
    }

    .bg-purple {
        background-color: #6f42c1;
    }

    .br-15 {
        border-radius: 15px;
    }

    .br-top-15 {
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

    .btn-purple {
        background-color: #6f42c1;
        color: white;
        transition: 0.3s;
    }

        .btn-purple:hover {
            background-color: #59359a;
            color: white;
            transform: translateY(-2px);
        }

    .btn-outline-purple {
        color: #6f42c1;
        border-color: #6f42c1;
    }

        .btn-outline-purple:hover {
            background-color: #6f42c1;
            color: white;
        }

    .custom-input {
        border: 1px solid #e1ddec;
        border-radius: 8px;
        padding: 0.6rem;
    }

    .employee-link:hover {
        color: #6f42c1 !important;
        text-decoration: underline !important;
    }

    .print-only {
        display: none;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        .print-only {
            display: block !important;
        }

        body {
            background: white;
        }
    }
</style>

@code {
    private List<Employee> employees = new();
    private List<Position> availablePositions = new();
    private List<Department> availableDepartments = new();

    private Employee newEmployee = new() { PositionId = 0, DepartmentId = 0, Status = EmployeeStatus.Active };
    private Employee editingEmployee = new();

    private string searchTerm = "";
    private int filterDeptId = 0;
    private bool isEditing = false;

    private IEnumerable<Employee> FilteredEmployees => employees
        .Where(e => string.IsNullOrWhiteSpace(searchTerm) || e.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(e => filterDeptId == 0 || e.DepartmentId == filterDeptId);

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        employees = await DbContext.Employees.Include(e => e.Position).Include(e => e.Department).ToListAsync();
        availablePositions = await DbContext.Positions.ToListAsync();
        availableDepartments = await DbContext.Departments.ToListAsync();
    }

    private async Task AddEmployee()
    {
        if (string.IsNullOrWhiteSpace(newEmployee.FullName) || newEmployee.PositionId == 0 || newEmployee.DepartmentId == 0) return;
        DbContext.Employees.Add(newEmployee);
        await DbContext.SaveChangesAsync();
        newEmployee = new Employee() { PositionId = 0, DepartmentId = 0, Status = EmployeeStatus.Active };
        await LoadData();
    }

    private void EditEmployee(Employee emp)
    {
        editingEmployee = new Employee
        {
            Id = emp.Id,
            FullName = emp.FullName,
            Salary = emp.Salary,
            Status = emp.Status,
            DepartmentId = emp.DepartmentId,
            PositionId = emp.PositionId
        };
        isEditing = true;
    }

    private async Task SaveEdit()
    {
        var dbEmp = await DbContext.Employees.FindAsync(editingEmployee.Id);
        if (dbEmp != null)
        {
            dbEmp.FullName = editingEmployee.FullName;
            dbEmp.Salary = editingEmployee.Salary;
            dbEmp.Status = editingEmployee.Status;
            await DbContext.SaveChangesAsync();
            isEditing = false;
            await LoadData();
        }
    }

    private void CancelEdit() => isEditing = false;

    private async Task DeleteEmployee(int id)
    {
        var emp = await DbContext.Employees.FindAsync(id);
        if (emp != null) { DbContext.Employees.Remove(emp); await DbContext.SaveChangesAsync(); await LoadData(); }
    }

    private async Task PrintReport() => await JS.InvokeVoidAsync("window.print");

    private string GetStatusText(EmployeeStatus status) => status switch
    {
        EmployeeStatus.Active => "Работает",
        EmployeeStatus.OnLeave => "В отпуске",
        EmployeeStatus.Sick => "Болеет",
        EmployeeStatus.Terminated => "Уволен",
        _ => "—"
    };

    private string GetStatusClass(EmployeeStatus status) => status switch
    {
        EmployeeStatus.Active => "bg-success",
        EmployeeStatus.OnLeave => "bg-warning text-dark",
        EmployeeStatus.Sick => "bg-danger",
        _ => "bg-secondary"
    };
}
