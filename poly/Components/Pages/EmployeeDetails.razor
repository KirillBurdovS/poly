@page "/employees/{Id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using poly.Models
@using poly.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>Карточка сотрудника</PageTitle>

<div class="page-bg">
    <div class="container">
        @if (loading)
        {
            <div class="empty-state">Загрузка...</div>
        }
        else if (employee == null)
        {
            <div class="card br-15">
                <div class="empty-state"><i class="bi bi-person-x"></i>Сотрудник не найден. <a href="employees">Вернуться к списку</a></div>
            </div>
        }
        else
        {
            <div class="page-header">
                <div class="d-flex align-items-center gap-3">
                    <a href="employees" class="btn-icon border" title="Назад к списку"><i class="bi bi-arrow-left"></i></a>
                    <h3 class="page-title">Карточка сотрудника</h3>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card br-15 overflow-hidden">
                        <div class="profile-cover"></div>
                        <div class="card-body px-4 pb-4 pt-0 text-center">
                            <div class="profile-avatar">@string.Concat(employee.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])))</div>
                            <h4 class="fw-bold mb-1">@employee.FullName</h4>
                            <div class="text-muted mb-3">@(employee.Position?.Title ?? "—")</div>
                            <span class="badge @employee.Status.BadgeClass()">@employee.Status.ToText()</span>
                            <div class="profile-facts">
                                <div><span>Отдел</span><strong>@(employee.Department?.Name ?? "—")</strong></div>
                                <div><span>Оклад</span><strong>@employee.Salary.ToString("N0") ₽</strong></div>
                                <div><span>Ставка</span><strong>@((employee.Position?.BaseSalary ?? 0).ToString("N0")) ₽/ч</strong></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="card br-15 p-4 h-100">
                                <div class="text-muted small mb-1">Всего отработано</div>
                                <div class="h3 fw-bold mb-0">@logs.Sum(l => l.HoursWorked) ч</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="card br-15 p-4 h-100">
                                <div class="text-muted small mb-1">Начислено по часам за всё время</div>
                                <div class="h3 fw-bold mb-0 text-purple">@logs.Sum(l => l.TotalSalary).ToString("N0") ₽</div>
                            </div>
                        </div>
                    </div>

                    <div class="card br-15 overflow-hidden">
                        <div class="px-4 py-3 d-flex justify-content-between align-items-center border-bottom">
                            <h5 class="card-title mb-0">История начислений</h5>
                            <span class="small text-muted">последние 10 записей</span>
                        </div>
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th class="ps-4">Дата</th>
                                    <th>Часы</th>
                                    <th>Ставка</th>
                                    <th class="text-end pe-4">Итого</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!logs.Any())
                                {
                                    <tr><td colspan="4" class="empty-state"><i class="bi bi-clock-history"></i>Начислений пока нет</td></tr>
                                }
                                @foreach (var log in logs.Take(10))
                                {
                                    <tr>
                                        <td class="ps-4 text-muted">@log.Date.ToShortDateString()</td>
                                        <td>@log.HoursWorked ч</td>
                                        <td>@log.HourlyRate.ToString("N0") ₽/ч</td>
                                        <td class="text-end pe-4 fw-semibold">@log.TotalSalary.ToString("N0") ₽</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Employee? employee;
    private List<WorkLog> logs = new();
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        employee = await db.Employees
            .Include(e => e.Position)
            .Include(e => e.Department)
            .FirstOrDefaultAsync(e => e.Id == Id);

        logs = employee == null
            ? new()
            : await db.WorkLogs
                .Where(l => l.EmployeeId == Id)
                .OrderByDescending(l => l.Date)
                .ToListAsync();
        loading = false;
    }
}
