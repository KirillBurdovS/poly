@page "/employees/{Id:int}"
@using poly.Models
@using poly.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@rendermode InteractiveServer

<div class="employees-container py-4">
    <div class="container">
        @if (employee == null)
        {
            <p>Загрузка...</p>
        }
        else
        {
            <div class="d-flex align-items-center mb-4">
                <a href="employees" class="btn btn-outline-purple rounded-circle me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h3 class="text-purple fw-bold mb-0">Карточка сотрудника</h3>
            </div>

            <div class="row g-4">
                <!-- Основные данные -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm br-15 p-4 text-center">
                        <div class="mx-auto bg-lavender text-purple rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-person-fill fs-1"></i>
                        </div>
                        <h4 class="fw-bold text-purple-dark">@employee.FullName</h4>
                        <span class="badge bg-lavender text-purple mb-3">@(employee.Position?.Title ?? "—")</span>
                        <hr>
                        <div class="text-start">
                            <p class="small text-muted mb-1">Отдел</p>
                            <p class="fw-bold">@(employee.Department?.Name ?? "—")</p>
                            <p class="small text-muted mb-1">Текущий оклад</p>
                            <p class="fw-bold">@employee.Salary.ToString("N0") ₽</p>
                        </div>
                    </div>
                </div>

                <!-- Статистика выплат -->
                <div class="col-md-8">
                    <div class="card border-0 shadow-sm br-15 p-4 mb-4">
                        <h5 class="fw-bold text-purple-dark mb-3">История начислений</h5>
                        <div class="row text-center">
                            <div class="col-6 border-end">
                                <div class="small text-muted">Всего отработано</div>
                                <div class="h3 fw-bold text-purple">@logs.Sum(l => l.HoursWorked) ч.</div>
                            </div>
                            <div class="col-6">
                                <div class="small text-muted">Выплачено за всё время</div>
                                <div class="h3 fw-bold text-success">@logs.Sum(l => l.TotalSalary).ToString("N0") ₽</div>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm br-15 overflow-hidden">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-purple-light">
                                <tr>
                                    <th class="ps-4">Дата</th>
                                    <th>Часы</th>
                                    <th>Ставка</th>
                                    <th>Итого</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in logs.Take(10))
                                {
                                    <tr>
                                        <td class="ps-4">@log.Date.ToShortDateString()</td>
                                        <td>@log.HoursWorked ч.</td>
                                        <td>@log.HourlyRate.ToString("N0") ₽</td>
                                        <td class="fw-bold">@log.TotalSalary.ToString("N0") ₽</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .employees-container {
        min-height: 100vh;
        background-color: #f3f0f7;
    }

    .text-purple {
        color: #6f42c1;
    }

    .text-purple-dark {
        color: #4b2c85;
    }

    .bg-lavender {
        background-color: #e9e4ff;
    }

    .br-15 {
        border-radius: 15px;
    }

    .bg-purple-light {
        background-color: #f8f6ff;
    }

    .btn-outline-purple {
        color: #6f42c1;
        border-color: #6f42c1;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    private Employee? employee;
    private List<WorkLog> logs = new();

    protected override async Task OnInitializedAsync()
    {
        employee = await DbContext.Employees
            .Include(e => e.Position)
            .Include(e => e.Department)
            .FirstOrDefaultAsync(e => e.Id == Id);

        if (employee != null)
        {
            logs = await DbContext.WorkLogs
                .Where(l => l.EmployeeId == Id)
                .OrderByDescending(l => l.Date)
                .ToListAsync();
        }
    }
}
